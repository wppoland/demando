msgstr "Tu sesión expiró. Vuelve a cargar la página e inténtalo de nuevo."

#: src/Service/EnquiryService.php:128
msgid "Please wait a moment before sending another enquiry."
msgstr "Espera un momento antes de enviar otra consulta."

